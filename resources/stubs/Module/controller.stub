<?php
namespace App\Http\Controllers\Admin;

use Illuminate\Http\Request;
use App\Repository\[repositoryName];
use Laililmahfud\Adminportal\Http\Crud;

class [controllerName] extends Crud\AdminModule
{
     protected static string $policy = "[policy]";
     protected static string $icon = "[icon]";
     protected static string $url = "[url]";
     protected static string $title = "[title]";
     protected static string $resourcePath = "admin.[resources]";
     protected static string $repository = [repositoryName]::class;

     public static function action(Crud\Action $action): Crud\Action
     {
          return $action
               ->crud(
                    create: fn(Request $request) => app([repositoryName]::class)->store($request),
                    update: fn(Request $request, $uuid) => app([repositoryName]::class)->update($request, $uuid),
                    delete: fn($uuid) => app([repositoryName]::class)->deleteByUuid($uuid),
               )
               ->bulkActions([
                    Crud\BulkAction::make("Delete")
                         ->icon('trash')
                         ->danger()
                         ->do(function (Request $request) {
                              app([repositoryName]::class)->deleteByListId($request->id);
                         }),
               ]);
     }

     public static function table(Crud\Table $table): Crud\Table
     {
          return $table
               ->columns([
                    Crud\Column::make('name')
                         ->label('Name')
                         ->sortable(),
               ])
               ->perPage(20);
     }

     public static function rules(Crud\Rules $rules): Crud\Rules
     {
          return $rules
               ->make([
                    'name' => 'required|max:250',
               ])
               ->create([])
               ->update([]);
     }

     public static function shared(Crud\SharedProp $share): Crud\SharedProp
     {
          return $share
               ->all(fn() => [])
               ->index(fn() => [])
               ->create(fn() => [])
               ->update(fn() => [])
               ->detail(fn() => []);
     }


}